{
  "version": 2,
  "buildCommand": "npm run build --workspace packages/shared && npm run build --workspace apps/api",
  "outputDirectory": "apps/api/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}