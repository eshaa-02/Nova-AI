# ============================================================
# Nova AI — Environment Variables Reference
# ============================================================
# This file documents every variable used across the monorepo.
# Actual runtime env files live in:
#   apps/api/.env   (backend — copy from apps/api/.env.example)
#   apps/web/.env.local (frontend — copy from apps/web/.env.example)
#
# NEVER commit real .env files. NEVER put secret keys in
# NEXT_PUBLIC_* variables — anything prefixed NEXT_PUBLIC_ is
# shipped to the browser.
# ============================================================

# ---------- Backend (apps/api/.env) ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/nova-ai

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-another-long-random-string

# Selects which AIProvider implementation the backend uses.
# One of: google | openai | anthropic | mock
# "mock" must never be used in production.
AI_PROVIDER=google

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# Leave empty to disable image generation; set to an image-capable Gemini model to enable it
GOOGLE_IMAGE_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# tavily | none  (none returns a clear "not configured" error, never fake results)
SEARCH_PROVIDER=none
TAVILY_API_KEY=

# runway | none — not implemented for any vendor yet
VIDEO_PROVIDER=none
RUNWAY_API_KEY=

# suno | none — not implemented for any vendor yet
MUSIC_PROVIDER=none
SUNO_API_KEY=

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Email (verification / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nova AI <no-reply@nova.ai>"

# OAuth (only shown in frontend UI if these are set)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------- Frontend (apps/web/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
