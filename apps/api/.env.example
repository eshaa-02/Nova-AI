NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/nova-ai

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-another-long-random-string

# google | openai | anthropic | mock  (mock must never be used in production)
AI_PROVIDER=google

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-pro-preview
# Leave empty to disable image generation. Set to a Gemini model that
# supports image output (check https://ai.google.dev/gemini-api/docs/models
# for current availability under your key) to enable it, e.g.:
# GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_IMAGE_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# tavily | none  (none returns a clear "not configured" error, never fake results)
SEARCH_PROVIDER=none
TAVILY_API_KEY=

# runway | none — not implemented for any vendor yet; only gates the error message
VIDEO_PROVIDER=none
RUNWAY_API_KEY=

# suno | none — not implemented for any vendor yet; only gates the error message
MUSIC_PROVIDER=none
SUNO_API_KEY=

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nova AI <no-reply@nova.ai>"

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
